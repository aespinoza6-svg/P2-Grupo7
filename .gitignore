# Entornos virtuales (cada integrante crea el suyo; no se suben)
.venv/
venv/
env/

# Archivos generados por Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Caché de pytest
.pytest_cache/

# Editores / sistema operativo
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Respaldos automáticos de Blender / Bonsai
*.blend1
*.ifc~

# Salidas temporales (lo que sí queremos versionar va en resultados/figuras)
resultados/tmp/
resultados/lab/

# Campos 3D de la simulacion (15 MB cada uno): se generan con scripts/14 --vtk
resultados/e11/**/*.vtk

# E12: campos 3D en los instantes de T max y ΔT max (15 MB cada uno): scripts/14 --vtk-maximos
resultados/e12/**/*.vtk
